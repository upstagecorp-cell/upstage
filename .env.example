# Public HTTPS origin used by sitemap and robots. No indexing without a configured URL.
NEXT_PUBLIC_SITE_URL=

# Optional canonical origin for same-origin validation behind a trusted reverse proxy.
# Example: https://your-domain.com (no trailing path). Locally the request origin is used.
APP_ORIGIN=

# Server-only durable SQLite path. Default: .data/nexora.sqlite.
# Use a persistent volume for one Node.js application instance.
NEXORA_DB_PATH=

# Server-only text generation. BOTH fields are required; there is no mock fallback.
# Select a model supporting Responses API structured outputs in your provider account.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional numeric limits. Defaults: 60000 ms, 6000 output tokens, 10 jobs/hour/account.
OPENAI_TIMEOUT_MS=
OPENAI_MAX_OUTPUT_TOKENS=
NEXORA_GENERATIONS_PER_HOUR=
# Whole-service daily attempt cap in UTC (default 500); successful customer allowance is separate.
NEXORA_DAILY_GENERATION_LIMIT=

# Public support contact shown in legal and account pages.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Stripe-hosted monthly subscriptions. Server-only; leave launch disabled until the runbook passes.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Legacy text catalog only: USD monthly, exclusive tax, Focus $149 / Growth $299.
# Creative plan previews use a separate catalog. New checkout is closed until media delivery
# and a versioned Stripe catalog are implemented; launch flags cannot bypass that preview status.
STRIPE_PRICE_FOCUS=
STRIPE_PRICE_GROWTH=
# Dedicated portal configuration: cancel at period end, invoices/payment method update;
# disable plan switching, pause, and quantity changes in the initial release.
STRIPE_PORTAL_CONFIGURATION=
NEXORA_PAID_LAUNCH_ENABLED=false

# Transactional account email, configured and verified with Resend. No marketing emails.
RESEND_API_KEY=
NEXORA_EMAIL_FROM=

# Legal seller details. These must match the actual Stripe seller.
NEXORA_LEGAL_NAME=
NEXORA_LEGAL_ADDRESS=
# Operator attestations after legal review and live end-to-end verification; see launch runbook.
NEXORA_LEGAL_APPROVED=false
NEXORA_LIVE_TESTS_APPROVED=false
