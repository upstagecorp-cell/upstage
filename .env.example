# Public HTTPS origin used by sitemap and robots. No indexing without a configured URL.
NEXT_PUBLIC_SITE_URL=

# Optional canonical origin for same-origin validation behind a trusted reverse proxy.
# Example: https://your-domain.com (no trailing path). Locally the request origin is used.
APP_ORIGIN=

# Supabase server connection. Never expose the secret key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connect > Session pooler > URI. Server-only; used by the migration commands.
SUPABASE_DATABASE_URL=

# Server-only durable SQLite path. Default: .data/nexora.sqlite.
# Use a persistent volume for one Node.js application instance.
NEXORA_DB_PATH=

# Server-only text generation. There is no mock fallback.
# Recommended production direction: Google Gemini/Vertex adapter.
# AI_PROVIDER accepts google (or gemini) and openai. If omitted, legacy OpenAI mode is used.
AI_PROVIDER=google
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
# Legacy OpenAI-only compatibility. Keep these for existing deployments until migration.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional Gemini Developer API compatibility; Vertex AI should use server-side workload identity in production.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional numeric limits. Defaults: 60000 ms, 6000 output tokens, 10 jobs/hour/account.
AI_TIMEOUT_MS=
AI_MAX_OUTPUT_TOKENS=
OPENAI_TIMEOUT_MS=
OPENAI_MAX_OUTPUT_TOKENS=
NEXORA_GENERATIONS_PER_HOUR=
# Whole-service daily attempt cap in UTC (default 500); successful customer allowance is separate.
NEXORA_DAILY_GENERATION_LIMIT=

# Public support contact shown in legal and account pages.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Stripe-hosted monthly subscriptions. Server-only; leave launch disabled until the runbook passes.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Legacy text catalog only: USD monthly, exclusive tax, Focus $149 / Growth $299.
# These are separate from the current creative catalog below and are retained for existing text rights.
STRIPE_PRICE_FOCUS=
STRIPE_PRICE_GROWTH=
# Dedicated portal configuration.
STRIPE_PORTAL_CONFIGURATION=
NEXORA_PAID_LAUNCH_ENABLED=false

# Transactional account email, configured and verified with Resend. No marketing emails.
RESEND_API_KEY=
NEXORA_EMAIL_FROM=

# Legal seller details. These must match the actual Stripe seller.
NEXORA_LEGAL_NAME=
NEXORA_LEGAL_ADDRESS=
NEXORA_LEGAL_APPROVED=false
NEXORA_LIVE_TESTS_APPROVED=false

# Creative recurring catalog: Core $29, Plus $59, Pro $99 before tax.
STRIPE_PRICE_CREATIVE_FOCUS=
STRIPE_PRICE_CREATIVE_GROWTH=
STRIPE_PRICE_CREATIVE_PRO=
# Optional short AI scene packs.
STRIPE_PRICE_MOTION_SCENE_MONTHLY=
STRIPE_PRICE_MOTION_FIVE_MONTHLY=
STRIPE_PRICE_MOTION_SCENE_ONCE=
STRIPE_PRICE_MOTION_FIVE_ONCE=
# One-time 30–90 second finished promotion video packs. They never renew.
# Basic: 30s $29.99, 45s $39.99, 60s $49.99, 90s $69.99.
# Plus with audio: 30s $39.99, 45s $49.99, 60s $64.99, 90s $89.99.
STRIPE_PRICE_VIDEO_30_ONCE=
STRIPE_PRICE_VIDEO_30_PLUS_ONCE=
STRIPE_PRICE_VIDEO_45_ONCE=
STRIPE_PRICE_VIDEO_45_PLUS_ONCE=
STRIPE_PRICE_VIDEO_60_ONCE=
STRIPE_PRICE_VIDEO_60_PLUS_ONCE=
STRIPE_PRICE_VIDEO_90_ONCE=
STRIPE_PRICE_VIDEO_90_PLUS_ONCE=
